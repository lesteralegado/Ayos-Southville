rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /residentProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['publicAlias', 'createdAt', 'updatedAt'])
        && request.resource.data.publicAlias is string
        && request.resource.data.publicAlias.size() >= 3
        && request.resource.data.publicAlias.size() <= 32;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicAlias', 'updatedAt'])
        && request.resource.data.publicAlias is string
        && request.resource.data.publicAlias.size() >= 3
        && request.resource.data.publicAlias.size() <= 32;
      allow delete: if false;
    }

    match /publicAliases/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /privateReports/{reference} {
      allow read: if request.auth != null && resource.data.reporterUid == request.auth.uid;
      allow write: if false;
    }

    match /publicReports/{reference} {
      allow read: if resource.data.approved == true
        && resource.data.status in ['Under review', 'Assigned', 'In progress', 'Resolved', 'Resident confirmed'];
      allow write: if false;
    }

    match /submissionReceipts/{receiptId} {
      allow read: if request.auth != null && resource.data.residentUid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
